# Copy to `.env` and adjust paths for your machine or shared host:
#   cp .env.example .env
#
# Used by local runs (`./run_orchestrator.sh`) and by Compose
# interpolation (`BITCOINFUZZ_REPO`). Docker Compose also sets the
# ORCHESTRATOR_* values inside the container; keep them here for
# API-only (non-Compose) runs.
#
# On a shared / team host, prefer absolute paths. Reaching the API from
# other machines also needs ORCHESTRATOR_HOST=0.0.0.0, but only set that
# together with ORCHESTRATOR_API_TOKEN: the campaign routes launch and stop
# containers on the Docker host, so an untokened public bind hands that to
# anyone who can route to the box.

# --- bitcoinfuzz checkout (Compose volume mounts) ---
# Path to the bitcoinfuzz repo that owns fuzz targets + ./docker data.
# For `docker compose`, use an absolute path. The host Docker daemon
# bind-mounts this into campaign containers; a relative path or the
# in-container /app/data path will point at the wrong directory.
# Sibling layout (dev):
BITCOINFUZZ_REPO=../bitcoinfuzz
# Shared host example:
# BITCOINFUZZ_REPO=/opt/bitcoinfuzz/bitcoinfuzz

# GID of the host docker.sock group. Required for Compose: the
# orchestrator runs as UID 1001 and cannot talk to a root:docker
# socket without this. Find it with:
#   stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# --- Paths (orchestrator config) ---
# Fuzz-target docker-compose.yml from bitcoinfuzz (NOT this repo's compose).
ORCHESTRATOR_COMPOSE_FILE=../bitcoinfuzz/docker-compose.yml
# Shared corpus/crash root as seen by this process.
# Local / API-only: the bitcoinfuzz docker/ directory.
# Compose sets this to /app/data inside the orchestrator container.
ORCHESTRATOR_DATA_DIR=../bitcoinfuzz/docker
# Host path the Docker daemon bind-mounts into campaign containers.
# Required when the orchestrator runs in Compose (must be absolute).
# Leave unset for local `./run_orchestrator.sh` (same as DATA_DIR).
# ORCHESTRATOR_HOST_DATA_DIR=/opt/bitcoinfuzz/bitcoinfuzz/docker
# SQLite database file for campaign state and crash records.
ORCHESTRATOR_DB_PATH=./orchestrator.db

# --- Server ---
# API bind address. Keep 127.0.0.1 unless ORCHESTRATOR_API_TOKEN is set;
# 0.0.0.0 exposes the container-control routes to the network.
ORCHESTRATOR_HOST=127.0.0.1
# REST API port (Swagger at http://HOST:PORT/docs).
ORCHESTRATOR_PORT=8000
# Prometheus metrics exporter port (/metrics).
ORCHESTRATOR_METRICS_PORT=9091

# --- Security ---
# Bearer token required on the mutating routes (POST/DELETE /campaigns,
# pause, resume, /api/alerts/webhook, /api/ci-hook). Unset means no auth,
# which is only safe on a loopback bind. Generate one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Alertmanager and any CI job posting to /api/ci-hook need the same value.
# ORCHESTRATOR_API_TOKEN=
# Browser origins allowed to call the API, comma-separated. Requests from
# curl or other non-browser clients are unaffected.
# ORCHESTRATOR_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
